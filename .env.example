# ==========================================
# Banking Rewards Platform - Environment Config
# ==========================================

# PostgreSQL Settings
POSTGRES_DB=rewardsdb
POSTGRES_USER=rewards_user
POSTGRES_PASSWORD=rewards_secure_pass_change_in_prod
POSTGRES_PORT=5432

# Spring Boot Backend Settings
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/rewardsdb
SPRING_DATASOURCE_USERNAME=rewards_user
SPRING_DATASOURCE_PASSWORD=rewards_secure_pass_change_in_prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# HikariCP Connection Pool Tuning
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
HIKARI_IDLE_TIMEOUT=300000
HIKARI_CONNECTION_TIMEOUT=20000
HIKARI_MAX_LIFETIME=1200000

# Frontend Settings (Build Time)
VITE_API_BASE_URL=/api
